# ── Server ────────────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_PATH=./data/gallery.db

# ── Auth ──────────────────────────────────────────────────────────────────
AUTH_MODE=dev
DEV_USER_EMAIL=ctluck@launchdarkly.com
DEV_USER_NAME=Connor Tluck
AUTH_PROXY_EMAIL_HEADER=x-forwarded-email
AUTH_PROXY_NAME_HEADER=x-forwarded-user

# ── LaunchDarkly ──────────────────────────────────────────────────────────
LD_API_TOKEN=
LD_BASE_URL=https://app.launchdarkly.com
LD_PROJECT_KEY=CT-Demo_Hub
LD_ENVIRONMENT_KEY=production

# ── GitHub ────────────────────────────────────────────────────────────────
GITHUB_TOKEN=
GALLERY_REPO=Connor-Tluck/LD_Demo_Hub_Version2
GALLERY_BASE_BRANCH=main
GITHUB_WEBHOOK_SECRET=

# ── Catalog ───────────────────────────────────────────────────────────────
# Monorepo: catalog lives at repo root, two levels up from app/server/src
CATALOG_SOURCE=local
CATALOG_DIR=../../catalog
CATALOG_TTL_SECONDS=60
